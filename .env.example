# Copy to .env (or export these in your shell). All are optional for local development.

# Signs the login tokens. Use a long random value in production:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# SQLite file in ./instance by default. For PostgreSQL (needs: pip install "psycopg[binary]"):
#   DATABASE_URL=postgresql://user:password@localhost:5432/blog
DATABASE_URL=sqlite:///blog.db

# How long a login token stays valid
TOKEN_TTL_MINUTES=60

# Set to 1 to run `python app.py` with the debugger and auto-reload
FLASK_DEBUG=0
